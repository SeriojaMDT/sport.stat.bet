+            runOnUiThread(()->{if(!"top".equals(screen)||!wanted.equals(topSelectedDate)){topLoading=false;topSignature="";return;}topItems.clear();topItems.addAll(result);topSignature=signature;topLoading=false;topMessage="";render();});
+        });
+    }
