+    boolean isHalfCompareModule(String m){return "goals_halves".equals(m)||"corners_halves".equals(m)||"cards_halves".equals(m);}
+    double[] halfComparisonValues(Fixture f,String module){
+        if(f==null)return null;
+        if("goals_halves".equals(module)){
+            if(f.score==null||f.score.ht==null||f.score.sh==null)return null;
+            return new double[]{f.score.ht[0]+f.score.ht[1],f.score.sh[0]+f.score.sh[1]};
+        }
+        String base="corners_halves".equals(module)?"corners":"cards";Metric m=metricFor(base);if(m==null)return null;
+        double[] a=metricHomeAwayValues(f,m.key,"HT"),b=metricHomeAwayValues(f,m.key,"2HT");if(a==null||b==null)return null;
+        return new double[]{a[0]+a[1],b[0]+b[1]};
+    }
+    String formatHalfCompareValue(String module,double v){return Math.abs(v-Math.rint(v))<.001?String.valueOf((int)Math.round(v)):one(v);}
+
+    String translateMarketLabel(String label){
+        if(label==null)return"";String x=label;
+        if(x.startsWith("Peste "))return tr("Peste")+x.substring(5);
+        if(x.startsWith("Sub "))return tr("Sub")+x.substring(3);
+        if(x.startsWith("Șansă dublă "))return tr("Șansă dublă")+x.substring("Șansă dublă".length());
+        return tr(x);
+    }
